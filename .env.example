# Copy to .env (make does this for you). .env is gitignored: keys never leave the server.

# Postgres (docker compose)
POSTGRES_USER=nivesh
POSTGRES_PASSWORD=nivesh-local-dev-only
POSTGRES_DB=nivesh

# Used by tools run on the host (make test, python -m services.migrate).
# Containers get their own DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgresql://nivesh:nivesh-local-dev-only@localhost:5432/nivesh

# Keys (needed from Phase 1 and Phase 3)
ANTHROPIC_API_KEY=
KITE_API_KEY=
KITE_API_SECRET=

# Mode and safety
MODE=personal
KILL_SWITCH=false

# Budget caps in USD (open decision D4)
BUDGET__PER_DAY_USD=25
BUDGET__PER_MONTH_USD=300

# Optional: a CA certificate file for a TLS-intercepting proxy, used during image builds.
# EXTRA_CA_CERT_FILE=/path/to/ca.crt
